import QtQuick
import QtQuick.Layouts
import Quickshell.Hyprland
import qs.Commons
import qs.Ui

BarWidget {
  id: root
  moduleName: "__PLUGIN_ID__"

  // Set labels with:
  //   omarchy-workspace-name 1 "Web"
  // They are stored in this widget's shell.json entry as a { "1": "Web" } map.
  readonly property var configuredNames: setting("names", ({}))

  function workspaceById(id) {
    var values = Hyprland.workspaces.values
    for (var i = 0; i < values.length; i++) {
      if (values[i].id === id) return values[i]
    }

    return null
  }

  function workspaceIds() {
    var ids = [1, 2, 3, 4, 5]
    var values = Hyprland.workspaces.values

    for (var i = 0; i < values.length; i++) {
      var id = values[i].id
      if (id > 0 && id <= 10 && ids.indexOf(id) === -1) ids.push(id)
    }

    ids.sort(function(left, right) { return left - right })
    return ids
  }

  function workspaceName(id) {
    var configured = configuredNames ? configuredNames[String(id)] : undefined
    if (configured !== undefined && configured !== null && String(configured).trim() !== "")
      return String(configured).trim()

    // Also honour a live Hyprland rename when one is present.
    var workspace = workspaceById(id)
    if (workspace && workspace.name !== undefined && workspace.name !== null) {
      var liveName = String(workspace.name).trim()
      if (liveName !== "" && liveName !== String(id)) return liveName
    }

    return ""
  }

  function workspaceText(id, focused) {
    var marker = focused ? "\uDB85\uDCFB" : (id === 10 ? "0" : String(id))
    var name = workspaceName(id)

    // On a horizontal bar the label sits to the right of the usual number/dot.
    // Keep the compact stock appearance if no label is configured.
    return !vertical && name !== "" ? marker + "  " + name : marker
  }

  function focusWorkspace(id) {
    if (!root.bar) return
    root.bar.run("hyprctl dispatch " + Util.shellQuote("hl.dsp.focus({ workspace = \"" + id + "\" })"))
  }

  readonly property real trailingGap: root.vertical ? 0 : Style.spaceReal(1.5)

  implicitWidth: grid.implicitWidth + trailingGap
  implicitHeight: grid.implicitHeight

  GridLayout {
    id: grid
    anchors.fill: parent
    anchors.rightMargin: root.trailingGap
    columns: root.vertical ? 1 : root.workspaceIds().length
    columnSpacing: root.vertical ? 0 : Style.space(1)
    rowSpacing: root.vertical ? Style.space(2) : 0

    Repeater {
      model: root.workspaceIds()

      WidgetButton {
        required property int modelData

        readonly property var workspace: root.workspaceById(modelData)
        readonly property bool occupied: workspace !== null && workspace.toplevels.values.length > 0
        readonly property bool focused: Hyprland.focusedWorkspace !== null && Hyprland.focusedWorkspace.id === modelData
        readonly property string workspaceLabel: root.workspaceName(modelData)

        bar: root.bar
        text: root.workspaceText(modelData, focused)
        opacity: occupied || focused ? 1 : 0.5
        horizontalMargin: workspaceLabel !== "" && !root.vertical ? 8 : 6
        verticalPadding: 6
        fixedWidth: root.vertical || workspaceLabel === "" ? (root.vertical ? root.barSize : Style.space(20)) : -1
        fixedHeight: root.barSize
        tooltipText: workspaceLabel !== ""
          ? "Workspace " + modelData + ": " + workspaceLabel
          : "Workspace " + modelData
        onPressed: function(button) {
          if (button === Qt.LeftButton) root.focusWorkspace(modelData)
        }
      }
    }
  }
}
