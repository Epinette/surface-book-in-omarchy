#!/usr/bin/env bash
# Surface Book 2 camera helper for Omarchy. No camera capture at login/boot.
# Sources and usage: README.md in the surface-book-in-omarchy repository.
set -Eeuo pipefail
export LC_ALL=C

fail() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
note() { printf '\n%s\n' "$*"; }
need() { command -v "$1" >/dev/null || fail "Missing $1. Run this script's setup command first."; }
trap 'printf "Command failed at line %s (exit %s). Setup may be incomplete.\n" "$LINENO" "$?" >&2' ERR

usage() {
  cat <<'EOF'
Surface Book 2 camera helper for Omarchy

  surface-camera doctor             Inspect hardware and missing software
  surface-camera setup              Install missing camera/app packages
  surface-camera prepare            Apply the opted-in workaround for this boot
  surface-camera test [front|rear]   Test continuous frames, twice
  surface-camera webcam [front|rear] Feed camera to the browser until Ctrl+C
  surface-camera preview            Open qcam; close before webcam/test

Default command: doctor. Run as your desktop user, not with sudo.
After a reboot, test/webcam automatically prepare the camera when its driver is
unloaded. This applies the explicitly opted-in camera-only DMA isolation bypass
until the next reboot. Administrator authentication may be requested for that
step and the virtual device. Capture itself runs as your regular user.

Start webcam BEFORE opening/reloading Zoom or WhatsApp. Select "Surface Camera".
Keep the terminal open during the call. Ctrl+C stops the camera feed.

Optional environment variables:
  SURFACE_CAMERA_SIZE=640x480    Alternative to the default 1280x720
  SURFACE_CAMERA_FLIP=2          Rotate 180 degrees (default 0, unchanged)
  SURFACE_CAMERA_ID='...'        Exact camera ID from cam --list, if needed

Before capture, review README.md and run the repository's install.sh with
--enable-dma-workaround, then reboot manually if instructed. The workaround
removes DMA isolation for the camera controller; it is NOT enabled by default.

Setup installs only missing camera/app packages. It does not run a system upgrade,
restart desktop/media services, or reboot the computer.
EOF
}

check_machine() {
  local model
  model=$(cat /sys/class/dmi/id/product_name)
  [[ $model == 'Surface Book 2' ]] || fail "This script targets Surface Book 2; detected: $model"
  command -v pacman >/dev/null || fail 'This script requires Arch/Omarchy.'
  (( EUID != 0 )) || fail 'Run as your regular desktop user; do not sudo the entire script.'
}

capture_ready() {
  local kernel_log
  kernel_log=$(journalctl -b -k --no-pager -o cat) || fail 'Cannot check camera-driver health.'
  if grep -Eq 'ipu3-imgu.*failed to start|DMAR:.*00:05[.]0|Oops:|BUG:|RIP:.*imgu_' <<< "$kernel_log"; then
    fail 'A kernel/camera fault occurred this boot. Further capture is disabled; do not remove or reload the driver.'
  fi
  [[ -L /sys/bus/pci/devices/0000:00:05.0/driver ]] || fail 'The image processor driver is not bound. Camera preparation is required before capture; do not retry after a kernel fault.'
  if [[ -r /sys/module/ipu3_imgu/initstate && $(cat /sys/module/ipu3_imgu/initstate) == going ]]; then
    fail 'The camera driver is stuck unloading after a kernel fault. Further capture is disabled this boot. Save other work and arrange a restart later; this script will not restart the computer.'
  fi
  local dma_mode
  dma_mode=$(cat /sys/bus/pci/devices/0000:00:05.0/iommu_group/type)
  [[ $dma_mode == identity || $dma_mode == IDENTITY ]] || fail 'This kernel needs the approved camera-only DMA workaround before capture. Do not start the known-failing default pipeline.'
}

admin() {
  if [[ -t 0 ]]; then sudo "$@"; else pkexec "$@"; fi
}

workaround_authorized() {
  local consent=${XDG_CONFIG_HOME:-$HOME/.config}/surface-camera/allow-dma-workaround
  [[ -f $consent && -r $consent && $(< "$consent") == camera-only-identity ]]
}

prepare_camera() {
  workaround_authorized ||
    fail 'The camera DMA workaround is not enabled. Read the repository README, then run ./install.sh --enable-dma-workaround to opt in explicitly.'
  if [[ ! -d /sys/module/ipu3_imgu && ! -e /sys/bus/pci/devices/0000:00:05.0/driver ]]; then
    local helper
    helper="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/surface-camera-dma"
    [[ -f $helper ]] || helper+=.sh
    [[ -f $helper ]] || fail 'The companion surface-camera-dma helper is missing.'
    note 'Preparing the opted-in camera-only DMA workaround for this boot.'
    admin /usr/bin/bash "$helper" enable --accept-camera-dma-risk
  fi
  capture_ready
}

lock_capture() {
  need flock
  [[ -n ${XDG_RUNTIME_DIR:-} && -d $XDG_RUNTIME_DIR && -O $XDG_RUNTIME_DIR ]] ||
    fail 'Run camera commands from your logged-in desktop session.'
  exec 9>"$XDG_RUNTIME_DIR/surface-camera.lock"
  flock -n 9 || fail 'Another Surface Camera command is running. Close it first.'
}

doctor() {
  local p node missing=0
  note 'Machine and kernel'
  cat /sys/class/dmi/id/product_name
  uname -r
  note 'Required packages'
  for p in libcamera libcamera-ipa libcamera-tools gst-plugin-libcamera \
           gst-plugins-base gst-plugins-good pipewire-libcamera v4l-utils v4l2loopback-dkms; do
    if ! pacman -Q "$p" 2>/dev/null; then printf 'MISSING: %s\n' "$p"; missing=1; fi
  done
  note 'Sensor drivers'
  for node in /sys/bus/i2c/devices/i2c-INT33BE:00/driver \
              /sys/bus/i2c/devices/i2c-INT347A:00/driver \
              /sys/bus/i2c/devices/i2c-INT347E:00/driver; do
    if [[ -L $node ]]; then readlink "$node"; else printf 'Not bound: %s\n' "$node"; fi
  done
  note 'Camera device access'
  shopt -s nullglob
  local nodes=(/dev/media* /dev/video* /dev/v4l-subdev*)
  if (( ${#nodes[@]} == 0 )); then
    printf 'No camera device nodes visible. Run from a regular desktop terminal.\n'
  fi
  for node in "${nodes[@]}"; do
    if [[ -r $node && -w $node ]]; then printf 'Accessible: %s\n' "$node"
    else printf 'No read/write access: %s\n' "$node"; fi
  done
  note 'Firmware and loopback module'
  local firmware=(/usr/lib/firmware/intel/ipu3-fw.bin*)
  if (( ${#firmware[@]} )); then printf '%s\n' "${firmware[@]}"
  else printf 'IPU3 firmware path missing. Inspect kernel logs.\n'; fi
  if modinfo -n v4l2loopback 2>/dev/null; then :
  else printf 'No v4l2loopback module for the running kernel.\n'; fi
  if command -v cam >/dev/null; then
    if [[ -r /sys/module/ipu3_imgu/initstate && $(cat /sys/module/ipu3_imgu/initstate) == going ]]; then
      note 'Camera driver is stuck unloading after a kernel fault. Capture disabled until a later clean boot.'
    else
      note 'libcamera enumeration (does not stream images)'
      timeout 20s cam --list || printf 'Camera enumeration failed or timed out.\n'
    fi
  fi
  if (( missing )); then note 'Next: setup, then test front.'; fi
}

setup() {
  need omarchy
  (( $# == 0 )) || fail 'setup takes no arguments; system updates are intentionally separate.'
  local kernel_base p
  [[ -r /usr/lib/modules/$(uname -r)/pkgbase ]] ||
    fail 'Running kernel files are missing, possibly after an upgrade. Reboot and rerun setup.'
  kernel_base=$(cat "/usr/lib/modules/$(uname -r)/pkgbase")
  [[ $kernel_base =~ ^linux[-a-zA-Z0-9]*$ ]] || fail 'Cannot determine matching kernel headers.'
  local packages=(libcamera libcamera-ipa libcamera-tools gst-plugin-libcamera \
    gst-plugins-base gst-plugins-good pipewire-libcamera v4l-utils \
    python foot desktop-file-utils polkit sudo \
    v4l2loopback-dkms dkms gcc make "${kernel_base}-headers" linux-firmware-intel)
  local missing=()
  for p in "${packages[@]}"; do
    pacman -Q "$p" >/dev/null 2>&1 || missing+=("$p")
  done
  if (( ${#missing[@]} )); then
    [[ -t 0 ]] || fail 'Run setup in a terminal for administrator authentication.'
    # An ISO install may only have offline.db. Never do a bare pacman -Sy here.
    [[ -f /var/lib/pacman/sync/core.db && -f /var/lib/pacman/sync/extra.db ]] ||
      fail 'Online package indexes are absent. Arrange a normal Omarchy update when other work is finished, or a reviewed compatible package installation.'
    note 'Installing missing camera packages with Omarchy; no system update or restart is requested.'
    omarchy pkg add "${missing[@]}"
  fi
  if ! modinfo v4l2loopback >/dev/null 2>&1; then
    fail 'Loopback module unavailable for this kernel. Reboot if the kernel updated; otherwise inspect dkms status and its build log, then rerun setup.'
  fi
  note 'Packages ready. Run test front, then webcam front. Close other camera apps first.'
}

select_camera() {
  local side=$1 listing
  [[ $side == front || $side == rear ]] || fail 'Choose front or rear.'
  prepare_camera
  need cam
  need python3
  listing=$(timeout 20s cam --list) || fail 'libcamera could not enumerate cameras. Run doctor.'
  if [[ -n ${SURFACE_CAMERA_ID:-} ]]; then
    CAMERA_ID=$SURFACE_CAMERA_ID
  else
    CAMERA_ID=$(printf '%s\n' "$listing" | python3 -c '
import re, sys
side = sys.argv[1]
matches = []
for line in sys.stdin:
    match = re.match(r"^\s*\d+:\s+(.*?)\s+\((.*)\)\s*$", line)
    if not match:
        continue
    label, identity = match.groups()
    text = (label + " " + identity).lower()
    hints = ("front", "camf", "ov5693", "int33be") if side == "front" else ("rear", "back", "camr", "ov8865", "int347a")
    if any(hint in text for hint in hints):
        matches.append(identity)
if len(matches) != 1:
    sys.exit("Could not uniquely identify the " + side + " camera. Use SURFACE_CAMERA_ID from cam --list.")
print(matches[0])
' "$side") || fail 'Camera selection failed. Run doctor for the device and package status.'
  fi
  [[ -n $CAMERA_ID ]] || fail 'Empty camera ID.'
  note "Selected $side camera: $CAMERA_ID"
}

prepare_pipeline() {
  local size=${SURFACE_CAMERA_SIZE:-1280x720} flip=${SURFACE_CAMERA_FLIP:-0} element escaped_id
  [[ $size =~ ^([1-9][0-9]{1,3})x([1-9][0-9]{1,3})$ ]] || fail 'Use a size such as 1280x720 or 640x480.'
  local width=${BASH_REMATCH[1]} height=${BASH_REMATCH[2]}
  [[ $flip =~ ^[0-7]$ ]] || fail 'SURFACE_CAMERA_FLIP must be 0 through 7 (GStreamer videoflip method).'
  need gst-launch-1.0
  for element in libcamerasrc videoconvert videoflip identity fakesink v4l2sink; do
    gst-inspect-1.0 "$element" >/dev/null 2>&1 || fail "GStreamer element missing: $element. Rerun setup."
  done
  # gst-launch parses its arguments a second time. Preserve ACPI backslashes
  # and quote the entire property value for that parser as well as the shell.
  escaped_id=${CAMERA_ID//\\/\\\\}
  escaped_id=${escaped_id//\"/\\\"}
  PIPELINE=(gst-launch-1.0 -e libcamerasrc "camera-name=\"$escaped_id\"" '!'
    "video/x-raw,format=NV12,width=$width,height=$height,framerate=30/1,colorimetry=bt709" '!'
    queue max-size-buffers=2 leaky=downstream '!' videoconvert '!'
    videoflip "method=$flip" '!' 'video/x-raw,format=YUY2' '!')
}

test_camera() {
  lock_capture
  select_camera "${1:-front}"
  prepare_pipeline
  local pass
  note 'Testing continuous frames twice. The camera light may turn on; no images are saved.'
  for pass in 1 2; do
    capture_ready
    note "Capture test $pass of 2"
    if ! timeout --signal=INT --kill-after=5s 25s "${PIPELINE[@]}" \
      identity eos-after=90 '!' fakesink sync=false; then
      fail 'Capture stalled or failed. Inspect kernel logs before another attempt; do not unload/rebind this driver. A kernel fault requires a later clean boot.'
    fi
  done
  note 'Both multi-frame tests passed. This verifies capture, not image quality or a browser call.'
}

webcam() {
  lock_capture
  select_camera "${1:-front}"
  prepare_pipeline
  need v4l2-ctl
  local device=/dev/video42 label='Surface Camera' sys=/sys/devices/virtual/video4linux/video42
  if [[ -e $device ]]; then
    [[ -r $sys/name && $(cat "$sys/name") == "$label" ]] ||
      fail '/dev/video42 belongs to another device. This script will not replace it.'
  else
    [[ ! -d /sys/module/v4l2loopback ]] ||
      fail 'Another loopback configuration is loaded. It is left untouched; reboot before starting this helper.'
    modinfo v4l2loopback >/dev/null 2>&1 || fail 'No loopback module for this kernel. Run setup; a reboot may be needed.'
    admin /usr/bin/modprobe v4l2loopback devices=1 video_nr=42 "card_label=$label" exclusive_caps=1 max_buffers=4 ||
      fail 'Cannot load loopback. Check DKMS/module signing errors. Secure Boot settings are left unchanged.'
    udevadm settle --timeout=10
  fi
  [[ -c $device && -r $device && -w $device ]] ||
    fail 'Virtual camera is not accessible. Try logging out/in, then doctor. Do not chmod camera devices globally.'
  local caps
  caps=$(v4l2-ctl -d "$device" -D) || fail 'Cannot read virtual camera capabilities.'
  [[ $caps == *'Video Output'* && $caps != *'Video Capture'* ]] ||
    fail 'Surface Camera is busy or lacks exclusive_caps=1. Close other camera producers; if needed reboot and retry.'
  # Clear any stale frame if the producer stalls, without freezing someone's
  # last image indefinitely. These are controls on our own labelled device.
  v4l2-ctl -d "$device" -c timeout=3000
  note 'Starting Surface Camera. Once streaming, reload the browser page and choose Surface Camera.'
  note 'Keep this terminal open. Ctrl+C stops capture. No recording, upload, or autostart is configured.'
  exec "${PIPELINE[@]}" v4l2sink "device=$device" sync=false
}

main() {
  local action=${1:-doctor}
  (( $# == 0 )) || shift
  case "$action" in
    -h|--help|help) usage; return ;;
    doctor|setup|prepare|test|webcam|preview) ;;
    *) usage >&2; fail "Unknown command: $action" ;;
  esac
  check_machine
  case "$action" in
    doctor) (( $# == 0 )) || fail 'doctor takes no arguments.'; doctor ;;
    setup) (( $# == 0 )) || fail 'Use setup without arguments.'; setup ;;
    prepare) (( $# == 0 )) || fail 'prepare takes no arguments.'; lock_capture; prepare_camera ;;
    test) (( $# <= 1 )) || fail 'Use test [front|rear].'; test_camera "$@" ;;
    webcam) (( $# <= 1 )) || fail 'Use webcam [front|rear].'; webcam "$@" ;;
    preview) (( $# == 0 )) || fail 'preview takes no arguments.'; lock_capture; prepare_camera; need qcam; exec qcam ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
